GARMIN_EMAIL=<your garmin connect email>
GARMIN_PASSWORD=<your garmin connect password>
# Optional: where cached session tokens are stored, so you don't have to
# log in / redo MFA on every sync. Defaults to ~/.garmin-running-coach-tokens
# Use a directory dedicated to this skill - don't point it at a token
# directory used by another tool/project, since incompatible cached tokens
# there can cause confusing 401 errors.
GARMINTOKENS=~/.garmin-running-coach-tokens
